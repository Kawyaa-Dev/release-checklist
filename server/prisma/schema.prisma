generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Release {
    id             String   @id @default(uuid())
    name           String
    date           DateTime
    additionalInfo String?
    completedSteps String[] @default([])
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([date])
}
